# Copy to .env and adjust for your environment.

# Development default: SQLite. For production use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://radpanel:secret@db:5432/radpanel
DATABASE_URL=sqlite+aiosqlite:///./radpanel.db

# Where the generated proxy.conf is written. On the FreeRADIUS host:
#   Debian/Ubuntu: /etc/freeradius/3.0/proxy.conf
#   RHEL/CentOS:   /etc/raddb/proxy.conf
PROXY_CONF_PATH=./generated/proxy.conf

# Validate config before applying (dry-run parse). Empty = skip.
# RADIUS_CHECK_CMD=freeradius -XC

# Reload FreeRADIUS after a successful apply. Empty = skip.
# RADIUS_RELOAD_CMD=systemctl reload freeradius

# Frontend origin(s) allowed by CORS, comma-separated.
CORS_ORIGINS=http://localhost:5173
