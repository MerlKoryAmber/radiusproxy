#
# sites-enabled/default — FreeRADIUS Proxy Panel virtual server (baked into the
# image; static). A pure RADIUS proxy:
#   authorize  -> radiuspanel_route  (ordered rules: set Proxy-To-Realm or reject
#                                      + AD group gate)  [policy.d/radiuspanel]
#   pre-proxy  -> radiuspanel_srcip  (preserve originator IP)
#   post-auth  -> radiuspanel_log    (one row per decision, + Post-Auth-Type REJECT)
# The dynamic pieces (clients/proxy/policy/sql) are written by the panel on apply.
#
server default {
	listen {
		type = auth
		ipaddr = *
		port = 0
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}
	listen {
		type = acct
		ipaddr = *
		port = 0
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}

	authorize {
		preprocess
		radiuspanel_route
	}

	authenticate {
	}

	preacct {
		preprocess
	}

	accounting {
	}

	pre-proxy {
		radiuspanel_srcip
	}

	post-proxy {
		# Log the proxied Access-Challenge the moment it comes back from the
		# home server — BEFORE the request may later be re-classified as a
		# reject (e.g. the client never answers the OTP prompt and it times
		# out). Without this the decision log shows only the final reject and
		# the challenge is invisible. String xlat of Packet-Type (the &attr
		# compare does not match here in FR 3.2). ADR-0013.
		if ("%{reply:Packet-Type}" == "Access-Challenge") {
			radiuspanel_log
		}
	}

	post-auth {
		radiuspanel_log

		Post-Auth-Type REJECT {
			radiuspanel_log
		}

		# A proxied Access-Challenge (2FA asking for an OTP) lands here, not in
		# the normal post-auth flow — log it so the decision log shows it.
		Post-Auth-Type Challenge {
			radiuspanel_log
		}
	}
}
